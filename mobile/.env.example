# Base URL of the FastAPI backend (main.py), reachable from your phone/simulator.
# "localhost" only works from an iOS Simulator running on the same Mac as the
# backend. For an Android emulator use http://10.0.2.2:8888, and for a
# physical device use your computer's LAN IP, e.g. http://192.168.1.50:8888
EXPO_PUBLIC_API_BASE_URL=http://localhost:8888
